generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password_hash  String
  name           String
  email_verified Boolean  @default(false)
  created_at     DateTime @default(now())

  otp_hash       String?
  otp_purpose    String?   // "verify" | "reset"
  otp_expires_at DateTime?

  ratings Rating[]
  reviews Review[]

  @@map("users")
}

model Rating {
  id      Int  @id @default(autoincrement())
  pg_id   Int
  rating  Int
  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  @@unique([pg_id, user_id])
  @@map("ratings")
}

model Review {
  id              Int     @id @default(autoincrement())
  pg_id           Int
  review_text     String
  sentiment_score Float
  user_id         Int
  user            User    @relation(fields: [user_id], references: [id])

  @@unique([pg_id, user_id])
  @@map("reviews")
}
